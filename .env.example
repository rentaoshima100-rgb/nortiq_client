# ── アプリ ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# クライアント用 JWT の署名（設計 10.3）。Phase 2 で使用。
SUPABASE_JWT_SECRET=

# 添付ファイルのバケット名（マイグレーションが作成する）
SUPABASE_ATTACHMENTS_BUCKET=nq-attachments

# ── 社内ダッシュボードに入れるメールアドレス ────────────────
# カンマ区切り。Supabase Auth で認証済みでも、このリストにないメールは弾く。
STAFF_EMAILS=

