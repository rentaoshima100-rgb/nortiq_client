{
  "name": "nortiq-revise",
  "version": "0.1.0",
  "private": true,
  "description": "Nortiq Revise — 納品後の修正依頼をサイト上で受け付ける仕組み (Phase 0)",
  "scripts": {
    "dev": "npm run widget:build && next dev",
    "build": "npm run widget:build && next build",
    "start": "next start",
    "widget:build": "node scripts/build-widget.mjs",
    "widget:watch": "node scripts/build-widget.mjs --watch",
    "demo": "node scripts/serve-demo.mjs",
    "db:push": "node scripts/db-push.mjs",
    "typecheck:widget": "tsc -p widget/tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.24.2",
    "pg": "^8.22.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
